# Bloqueia a pasta .git e arquivos internos (o deploy da Hostinger copia o repositório inteiro)
RedirectMatch 404 /\.git
<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

# Mercronos — regras de cache (Hostinger / LiteSpeed)
# Páginas HTML: o navegador sempre confere se há versão nova antes de usar a guardada.
# JS e CSS: podem ficar guardados por 1 dia; a cada publicação o ?v= muda e força o download.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # o guardião das telas sem internet precisa sempre ser conferido
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html
